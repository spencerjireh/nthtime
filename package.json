{
  "name": "@nthtime/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nx dev @nthtime/web",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:stop": "docker compose -f docker-compose.dev.yml down",
    "dev:api": "if [ -f .env ]; then set -a; . ./.env; set +a; fi; cd services/api && ./gradlew bootRun",
    "api:build": "cd services/api && ./gradlew build",
    "api:test": "cd services/api && ./gradlew test",
    "build": "nx run-many --target=build",
    "lint": "nx run-many --target=lint",
    "lint:dead": "knip --no-exit-code",
    "lint:dead:fix": "knip --fix",
    "lint:dead:deep": "docker run --rm -v \"$(pwd):/data/project\" -v \"$(pwd)/services/api/.qodana/cache:/data/cache\" -v \"$(pwd)/services/api/.qodana/results:/data/results\" jetbrains/qodana-jvm-community:2025.3 --project-dir /data/project/services/api",
    "lint:dead:deep:baseline": "pnpm lint:dead:deep && cp services/api/.qodana/results/qodana.sarif.json services/api/qodana.sarif.json",
    "test": "nx run-many --target=test",
    "typecheck": "nx run-many --target=typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "nx e2e @nthtime/web",
    "validate": "npx tsx tools/validate-packs.ts",
    "validate:behavioral": "vitest run --config packs/vitest.config.mts",
    "validate:python": "npx tsx packs/python-test-helpers.ts",
    "validate:all": "pnpm validate && pnpm validate:behavioral && pnpm validate:python",
    "seed": "npx tsx tools/seed.ts",
    "seed:prod": "set -a; . ./.env.production; set +a; npx tsx tools/seed.ts",
    "analyze": "ANALYZE=true nx build @nthtime/web",
    "bench": "vitest bench libs/verification",
    "benchmark": "npx tsx tools/benchmark.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "nthtime": "node apps/cli/dist/cli.js"
  },
  "packageManager": "pnpm@10.23.0",
  "private": true,
  "devDependencies": {
    "@nx/eslint": "^22.5.1",
    "@nx/eslint-plugin": "^22.5.1",
    "@nx/js": "22.5.1",
    "@nx/next": "^22.5.1",
    "@nx/react": "^22.5.1",
    "@nx/vitest": "22.5.1",
    "@playwright/test": "^1.58.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "jsdom": "^28.1.0",
    "knip": "^6.4.1",
    "nx": "22.5.1",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "supertest": "^7.2.2",
    "tailwindcss": "3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "~16.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  }
}

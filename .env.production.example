# ── Next.js (apps/web) ────────────────────────────────────────────────

# Spring Boot API (internal Docker network)
SPRING_BOOT_URL=http://api:8080

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Public-facing URL
FRONTEND_URL=https://nthtime.spencerjireh.com

# Feature flags. These are inlined into the client bundle at build time --
# changing one requires a rebuild and redeploy, not just a restart.

# auth: OFF by default. Must be "true" to enable sign-in, /account and /author.
NEXT_PUBLIC_FF_AUTH=true

# solutionView: ON by default. Set to "false" to disable.
# NEXT_PUBLIC_FF_SOLUTION_VIEW=false

# ── Spring Boot (services/api) ───────────────────────────────────────

# PostgreSQL (must be set -- no defaults in production)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin secret for seed/sync operations
ADMIN_SECRET=

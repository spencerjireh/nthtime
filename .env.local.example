# ── Next.js (apps/web) ────────────────────────────────────────────────

# Spring Boot API (local dev -- matches docker-compose.dev.yml)
SPRING_BOOT_URL=http://localhost:8080

# Sentry (optional -- leave blank to disable error tracking)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Public-facing URL (used for OAuth redirect URIs)
FRONTEND_URL=http://localhost:3000

# Feature flags (default: ON -- set to "false" to disable)
# NEXT_PUBLIC_FF_AUTH=false
# NEXT_PUBLIC_FF_SOLUTION_VIEW=false

# ── Spring Boot (services/api) ───────────────────────────────────────

# PostgreSQL (defaults match docker-compose.dev.yml -- uncomment to override)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nthtime
# DB_USER=nthtime
# DB_PASSWORD=nthtime

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin secret for seed/sync operations
ADMIN_SECRET=

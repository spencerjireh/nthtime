{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*.ts", "packs/**/*.test.{ts,tsx}"],
      "project": ["tools/**/*.ts", "packs/**/*.test.{ts,tsx}"],
      "ignoreDependencies": ["express", "@types/express"]
    },
    "apps/web": {
      "entry": [
        "src/sentry.server.config.ts",
        "src/sentry.edge.config.ts",
        "src/test-utils.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["webpack"],
      "next": true,
      "vitest": true,
      "playwright": { "config": "playwright.config.ts", "entry": "e2e/**/*.spec.ts" },
      "tailwind": true,
      "eslint": true
    },
    "apps/cli": {
      "entry": [
        "tests/integration/**/*.{ts,tsx}",
        "scripts/*.js"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["web-tree-sitter", "tree-sitter-wasms"],
      "vitest": true,
      "eslint": true
    },
    "libs/*": {
      "entry": ["src/**/*.bench.ts"],
      "project": ["src/**/*.ts"],
      "vitest": true,
      "eslint": true
    },
    "libs/verification": {
      "entry": ["src/**/*.bench.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["express", "@types/express", "tree-sitter-wasms"],
      "vitest": true,
      "eslint": true
    }
  }
}
